rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProject(data) {
      return data.keys().hasAll(['name', 'framework', 'files', 'createdAt', 'userId']) 
             && data.name is string && data.name.size() <= 100
             && data.framework is string && data.framework.size() <= 50
             && data.files is list && data.files.size() <= 100
             && data.userId == request.auth.uid;
    }

    function isValidUser(data) {
      return data.keys().hasAny(['githubConfig', 'lastSynced'])
             && (!data.keys().hasAll(['githubConfig']) || (data.githubConfig is map));
    }

    // Users and Settings
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow write: if isOwner(userId) && isValidUser(request.resource.data);

      // Projects Subcollection
      match /projects/{projectId} {
        allow list, get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(projectId) && isValidProject(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }
  }
}
